<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClassIsland.ExcelTool</AssemblyName>
    <RootNamespace>ClassIsland.ExcelTool</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultAvaloniaItems>false</EnableDefaultAvaloniaItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>$(NoWarn);CS8618;CS8602;CS8604;NU1701;NETSDK1138</NoWarn>
    <!-- 插件不放自己的一套 CL 依赖，避免与主程序冲突 -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <PrivateAssets>all</PrivateAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClassIsland.PluginSdk" Version="2.0.1">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Excel 读写：纯托管库，无本地依赖，可随插件分发 -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <!-- 插件清单、图标与说明文档进输出目录（manifest.yml 里的 readme/icon 字段需要它们） -->
  <ItemGroup>
    <None Update="manifest.yml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('README.md')" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" Condition="Exists('LICENSE')" />
    <!-- README 里引用的截图，一并拷进输出目录，否则装到 ClassIsland 里看说明会图挂 -->
    <None Update="images\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('images')" />
  </ItemGroup>

</Project>
